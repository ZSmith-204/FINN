{
  "version": 1,
  "meta": { "name": "todo-relational-demo" },
  "database": {
    "file": "finn.db",
    "tables": {
      "lists": {
        "columns": {
          "id":         { "type": "integer", "primaryKey": true, "autoincrement": true },
          "title":      { "type": "text" },
          "created_at": { "type": "datetime", "default": "datetime('now')" }
        }
      },
      "todos": {
        "columns": {
          "id":      { "type": "integer", "primaryKey": true, "autoincrement": true },
          "list_id": { "type": "integer", "references": "lists.id", "onDelete": "CASCADE" },
          "title":   { "type": "text" },
          "done":    { "type": "boolean", "default": "false" }
        },
        "indexes": [ { "columns": ["list_id"] } ]
      }
    }
  },
  "api": {
    "basePath": "/api",
    "static": {
      "/": { "file": "index.html" }
    },
    "endpoints": {
      "/lists": {
        "get":  "SELECT id, title, created_at FROM lists ORDER BY id",
        "post": "INSERT INTO lists (title) VALUES (:title)"
      },
      "/lists/{id}": {
        "delete": "DELETE FROM lists WHERE id = :id"
      },
      "/lists/{id}/todos": {
        "get": "SELECT id, title, done FROM todos WHERE list_id = :id ORDER BY id"
      },
      "/todos": {
        "post": "INSERT INTO todos (list_id, title) VALUES (:list_id, :title)"
      },
      "/todos/{id}": {
        "patch":  "UPDATE todos SET done = :done WHERE id = :id",
        "delete": "DELETE FROM todos WHERE id = :id"
      },
      "/board": {
        "get": "SELECT t.id, t.title, t.done, l.id AS list_id, l.title AS list_title FROM todos t JOIN lists l ON l.id = t.list_id ORDER BY l.id, t.id"
      }
    }
  }
}
